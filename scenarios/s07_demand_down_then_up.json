{
  "name": "S07 demand decreases then increases",
  "why": "A demand can move both ways at any time and both go through the same recomputation. V1 does not hand A's unused power to B (fixed in V2).",
  "config": "config/station.json",
  "steps": [
    { "connect": { "as": "A", "charger": "CP1", "connector": 1, "demand_kw": 300 } },
    { "connect": { "as": "B", "charger": "CP2", "connector": 1, "demand_kw": 300 }, "expect": { "setpoints": { "A": 200, "B": 200 } } },
    { "change": { "session": "A", "demand_kw": 50 }, "expect": { "setpoints": { "A": 50, "B": 200 }, "allocated_kw": 250 } },
    { "change": { "session": "A", "demand_kw": 300 }, "expect": { "setpoints": { "A": 200, "B": 200 }, "allocated_kw": 400 } }
  ]
}
