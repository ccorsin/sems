{
  "name": "S10 saturated charger's share goes to the other charger",
  "why": "Nested limits: CP1 caps A and B at 150 kW each, so C on CP2 takes the 200 kW left of the 500 kW grid. V1 gave C only 500/3 = 166.7 kW and wasted 33.3 kW.",
  "config": { "grid_kw": 500, "chargers": [
    { "id": "CP1", "max_kw": 300, "connectors": [ { "id": 1 }, { "id": 2 } ] },
    { "id": "CP2", "max_kw": 300, "connectors": [ { "id": 1 }, { "id": 2 } ] } ] },
  "steps": [
    { "connect": { "as": "A", "charger": "CP1", "connector": 1, "demand_kw": 300 } },
    { "connect": { "as": "B", "charger": "CP1", "connector": 2, "demand_kw": 300 } },
    { "connect": { "as": "C", "charger": "CP2", "connector": 1, "demand_kw": 300 },
      "expect": { "setpoints": { "A": 150, "B": 150, "C": 200 }, "allocated_kw": 500 } }
  ]
}
