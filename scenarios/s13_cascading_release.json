{
  "name": "S13 cascading release",
  "why": "Power released by departures and a demand drop flows across several vehicles and chargers. In V1 the drop at step 6 leaves 113.3 kW unused (V2 should not).",
  "config": "config/station.json",
  "steps": [
    { "connect": { "as": "A", "charger": "CP1", "connector": 1, "demand_kw": 300 } },
    { "connect": { "as": "B", "charger": "CP1", "connector": 2, "demand_kw": 300 } },
    { "connect": { "as": "C", "charger": "CP2", "connector": 1, "demand_kw": 300 } },
    { "connect": { "as": "D", "charger": "CP2", "connector": 2, "demand_kw": 300 },
      "expect": { "setpoints": { "A": 100, "B": 100, "C": 100, "D": 100 } } },
    { "disconnect": "A", "expect": { "setpoints": { "B": 133.333, "C": 133.333, "D": 133.333 } } },
    { "change": { "session": "C", "demand_kw": 20 },
      "expect": { "setpoints": { "B": 133.333, "C": 20, "D": 133.333 }, "allocated_kw": 286.666 } },
    { "disconnect": "D", "expect": { "setpoints": { "B": 200, "C": 20 }, "allocated_kw": 220 } }
  ]
}
