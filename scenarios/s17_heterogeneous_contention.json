{
  "name": "S17 heterogeneous chargers under contention",
  "why": "Same mix as S09 on a 100 kW grid, so the sum of demands exceeds the grid: the 22 kW AC charger is served in full, the 300 kW and 50 kW DC chargers share the rest evenly (39 kW each).",
  "config": { "grid_kw": 100, "chargers": [
    { "id": "HPC", "max_kw": 300, "connectors": [ { "id": 1, "type": "CCS" }, { "id": 2, "type": "CCS" } ] },
    { "id": "DC50", "max_kw": 50, "connectors": [ { "id": 1, "type": "CCS" } ] },
    { "id": "AC22", "max_kw": 22, "connectors": [ { "id": 1, "type": "Type2" } ] } ] },
  "steps": [
    { "connect": { "as": "A", "charger": "HPC", "connector": 1, "demand_kw": 300 }, "expect": { "setpoints": { "A": 100 } } },
    { "connect": { "as": "B", "charger": "AC22", "connector": 1, "demand_kw": 22 }, "expect": { "setpoints": { "A": 78, "B": 22 } } },
    { "connect": { "as": "C", "charger": "DC50", "connector": 1, "demand_kw": 50 },
      "expect": { "setpoints": { "A": 39, "B": 22, "C": 39 }, "allocated_kw": 100 } }
  ]
}
